# Copy to .env on the cloud server and set a real domain you control.
DOMAIN=music.example.com

# Optional external PostgreSQL (set these in the hosting dashboard, never in dist).
# Otherwise local development and the Aliyun compose setup use SQLite.
# DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/postgres
# DATABASE_CA=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----
# REQUIRE_POSTGRES=true
